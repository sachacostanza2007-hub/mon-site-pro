# Copy this file to .env.local and fill in real values.
# The contact form (src/app/api/contact/route.ts) uses Resend to send emails.
# Get an API key at https://resend.com and verify the bycosta.eu sending domain.
RESEND_API_KEY=

# Address that receives contact form submissions. Defaults to contact@bycosta.eu.
CONTACT_TO_EMAIL=contact@bycosta.eu
